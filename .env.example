# Painel local e Control API
MONITOR_PORT=3001
MONITOR_CONTROL_API_URL=http://127.0.0.1:3001
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
MONITOR_CONTROL_API_TOKEN=replace_with_a_generated_32_character_token

# Conta coletora. Deixe vazia para apenas visualizar o dashboard local.
COLLECTOR_USERNAME=
COLLECTOR_PASSWORD=
COLLECTOR_PROXY_URL=
MONITOR_SESSION_ROOT=./state
COLLECTOR_STATE_DIR=./state/client-1

# Rodada direta de teste. O manager preenche webhook e alvo em uma rodada manual.
MONITOR_SIGNAL_WEBHOOK_URL=
RUN_ONCE=true
COLLECTOR_TARGET_IDS=
FOLLOWERS_WINDOW=80
RECENT_MEDIA_LIMIT=4
LIKERS_PER_MEDIA=30
PROFILE_ENRICHMENTS_PER_RUN=12

